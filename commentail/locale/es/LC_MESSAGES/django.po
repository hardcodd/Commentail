msgid "Requires comments whose text has not been erased and delete permission for every selected comment."
msgstr "Requiere comentarios cuyo texto no se haya borrado y permiso de eliminación para cada comentario seleccionado."

msgid "Management"
msgstr "Administración"

msgid "Search comments"
msgstr "Buscar comentarios"

msgid "Filters"
msgstr "Filtros"

msgid "Action availability"
msgstr "Disponibilidad de acciones"

msgid "Erase text"
msgstr "Borrar texto"

msgid "Close"
msgstr "Cerrar"

msgid "Date range"
msgstr "Intervalo de fechas"

msgid "Back to results"
msgstr "Volver a los resultados"

msgid "Appearance"
msgstr "Apariencia"

msgid "Moderation"
msgstr "Moderación"

msgid "Action not completed"
msgstr "Acción no completada"

msgid "The comments or available actions have changed."
msgstr "Los comentarios o las acciones disponibles han cambiado."

msgid "Your permissions no longer allow this action."
msgstr "Sus permisos ya no permiten realizar esta acción."

msgid "Some comments are no longer available or you no longer have access to them."
msgstr "Algunos comentarios ya no están disponibles o ya no tiene acceso a ellos."

msgid "Select between 1 and 100 comments and choose an available action."
msgstr "Seleccione entre 1 y 100 comentarios y una acción disponible."

msgid "Choose an available action for the author revision."
msgstr "Elija una acción disponible para la revisión del autor."

msgid "This author revision is no longer awaiting moderation."
msgstr "Esta revisión del autor ya no está pendiente de moderación."

msgid "No changes were made."
msgstr "No se ha realizado ningún cambio."

msgid "Return to your results to see the current statuses and select the comments again."
msgstr "Vuelva a los resultados para ver los estados actuales y seleccionar los comentarios de nuevo."

msgid "Ask an administrator to check your Commentail permissions before trying again."
msgstr "Pida a un administrador que compruebe sus permisos de Commentail antes de volver a intentarlo."

msgid "Back to dashboard"
msgstr "Volver al panel de control"

msgid "Spam prevention signals"
msgstr "Señales de prevención de spam"

msgid "Complete the spam check before sending."
msgstr "Complete la verificación antes de enviar."

msgid "This site's spam check requires JavaScript. Enable JavaScript in your browser, complete the check, then send your comment."
msgstr "La comprobación antispam de este sitio requiere JavaScript. Active JavaScript en su navegador, complete la comprobación y después envíe su comentario."

msgid "Too many attempts. Please wait and try again. Your draft is kept."
msgstr "Demasiados intentos. Espere y vuelva a intentarlo. Su borrador se conserva."

msgid "The hidden form field was filled in."
msgstr "Se rellenó el campo oculto del formulario."

msgid "The form was submitted unusually quickly."
msgstr "El formulario se envió inusualmente rápido."

msgid "The browser identification header was missing."
msgstr "Faltaba la cabecera de identificación del navegador."

msgid "The request came from another site."
msgstr "La solicitud procedía de otro sitio."

msgid "The same text was recently submitted on this site."
msgstr "El mismo texto se envió recientemente en este sitio."

msgid "The link count reached the review threshold."
msgstr "La cantidad de enlaces alcanzó el umbral de revisión."

msgid "Retry check"
msgstr "Reintentar la verificación"
