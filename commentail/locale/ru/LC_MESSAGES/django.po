msgstr "Комментариев для удаления текста: %(count)s"

msgid "The selected comments' text and revisions will be permanently erased."
msgstr "Текст выбранных комментариев и их правки будут удалены навсегда."

msgid "This cannot be undone. Replies will be preserved."
msgstr "Это действие необратимо. Ответы сохранятся."

msgid "Highlight staff names"
msgstr "Выделять имена сотрудников"

msgid "Adds a colored background to staff names and a golden crown for super administrators."
msgstr "Выделяет имена сотрудников цветной плашкой и добавляет золотую корону суперадминистраторам."

msgid "Super administrator"
msgstr "Суперадминистратор"

